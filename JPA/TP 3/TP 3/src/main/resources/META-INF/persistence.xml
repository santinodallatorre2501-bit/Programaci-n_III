<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">

    <!-- Definir la unidad de persistencia nombrada FacturacionPU -->
    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL"> <!--[cite: 1] -->

        <!-- Configurar el proveedor org.hibernate.jpa.HibernatePersistenceProvider -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider> <!--[cite: 1] -->

        <properties>
            <!-- Establecer la conexión hacia MySQL definiendo las propiedades estándar -->
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/> <!--[cite: 1] -->
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/base_ejemplo"/>

            <!-- Credenciales de acceso (user y password) -->
            <property name="javax.persistence.jdbc.user" value="root"/> <!--[cite: 1] -->
            <property name="javax.persistence.jdbc.password" value="@SantinoUTN"/> <!--[cite: 1] -->

            <!-- Propiedades de Hibernate -->
            <property name="hibernate.show_sql" value="true"/> <!--[cite: 1] -->
            <property name="hibernate.format_sql" value="true"/> <!--[cite: 1] -->
            <property name="hibernate.hbm2ddl.auto" value="update"/> <!--[cite: 1] -->
        </properties>

    </persistence-unit>
</persistence>